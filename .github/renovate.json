{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Ubuntu lanes are compatibility targets; change the matrix and provisioning together.",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/linux.yml"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "enabled": false
    }
  ]
}
